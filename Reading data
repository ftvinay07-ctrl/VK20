#include "main.h"

UART_HandleTypeDef huart1;

uint8_t received_data;

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();
    MX_USART1_UART_Init();

    while(1)
    {
        HAL_UART_Receive(&huart1,
                         &received_data,
                         1,
                         HAL_MAX_DELAY);

        HAL_UART_Transmit(&huart1,
                          &received_data,
                          1,
                          100);
    }
}
